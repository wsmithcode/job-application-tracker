generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  username String @unique
  email String @unique
  password String
  jobResearch JobResearch[] @relation("UserJobResearch")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model JobResearch {
  id String @id @default(uuid())
  userId String
  title String 
  jobApplications JobApplication[] @relation("JobResearchApplications")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  user User @relation("UserJobResearch", fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id String @id @default(uuid())
  JobResearchId String
  title String
  company String
  location String
  travelTime String
  link String
  note String
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  jobResearch JobResearch @relation("JobResearchApplications", fields: [JobResearchId], references: [id], onDelete: Cascade)
}